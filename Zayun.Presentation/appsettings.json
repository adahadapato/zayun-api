{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/zayun-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true,
          "flushToDiskInterval": "00:00:01",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "Zayun.Api"
    }
  },
  "AppSettings": {
    "ApiBaseUrl": "https://api.zayun.net",
    "WebsiteBaseUrl": "https://zayun.net"
  },
  "OpenApi": {
    "Enabled": false,
    "Title": "Zayun API",
    "Version": "v1",
    "Description": "Zayun backend: the portfolio's content (projects, research, experience, skills) and the Contact inbox.",
    "DocumentPath": "/openapi/{documentName}.json",
    "UiPath": "swagger",
    "Contact": {
      "Name": "Enobong Adahada",
      "Email": "",
      "Url": "https://github.com/adahadapato"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "SeedData": {
    "AdminEmail": "enobong.adahada@gmail.com",
    "AdminPassword": "",
    "AdminFirstName": "Enobong",
    "AdminLastName": "Adahada",
    "StarterDataEnabled": true,
    "StarterDataPath": "Seeding/Data/starter-data.json",
    "StarterImagesPath": "Seeding/Data/images"
  },
  "Identity": {
    "Password": {
      "RequiredLength": 10,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": false,
      "RequiredUniqueChars": 1
    },
    "Lockout": {
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 15,
      "AllowedForNewUsers": true
    }
  },
  "Jwt": {
    "Key": "",
    "Issuer": "Zayun-API",
    "Audience": "Zayun-Admin",
    "ExpiryMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Email": {
    "Enabled": false,
    "FromName": "Zayun",
    "FromAddress": "no-reply@zayun.net",
    "OwnerInbox": "enobong.adahada@gmail.com",
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "Username": "",
    "Password": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "https://zayun.net",
      "https://www.zayun.net"
    ]
  },
  "Storage": {
    "Local": {
      "PublicRootPath": "wwwroot/uploads",
      "PrivateRootPath": "App_Data/private-documents",
      "PrivateDownloadPath": "/private-files",
      "SigningKey": "",
      "PrivateLinkMinutes": 5
    }
  },
  "Images": {
    "MaxUploadBytes": 15728640,
    "MaxSide": 1920,
    "ThumbnailMaxSide": 640,
    "WebpQuality": 82
  },
  "Ai": {
    "Enabled": true,
    "ApiKey": "",
    "Model": "claude-haiku-5-5",
    "BaseUrl": "https://api.anthropic.com",
    "TimeoutSeconds": 10
  },
  "AllowedHosts": "*"
}